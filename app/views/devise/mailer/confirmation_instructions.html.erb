<%
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = t('devise_mailer.confirmation.welcome_eyebrow')
  heading = t('devise_mailer.confirmation.welcome_heading')
  intro_text = t('devise_mailer.confirmation.welcome_intro', brand_name: brand_name)
  supporting_text = t('devise_mailer.confirmation.welcome_supporting')
  action_text = t('devise_mailer.confirmation.welcome_action')
  confirmation_params = { confirmation_token: @token }
  confirmation_params[:route_url] = params[:redirect_url] if params[:redirect_url].present?
  action_url = frontend_url('auth/confirmation', **confirmation_params)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << [t('devise_mailer.confirmation.new_email_label'), @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = t('devise_mailer.confirmation.update_eyebrow')
    heading = t('devise_mailer.confirmation.update_heading')
    intro_text = t('devise_mailer.confirmation.update_intro', brand_name: brand_name)
    supporting_text = t('devise_mailer.confirmation.update_supporting')
    action_text = t('devise_mailer.confirmation.update_action')
  elsif @resource.confirmed?
    eyebrow = t('devise_mailer.confirmation.ready_eyebrow')
    heading = t('devise_mailer.confirmation.ready_heading')
    intro_text = t('devise_mailer.confirmation.ready_intro', brand_name: brand_name)
    supporting_text = t('devise_mailer.confirmation.ready_supporting')
    action_text = t('devise_mailer.confirmation.ready_action')
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    eyebrow = t('devise_mailer.confirmation.invite_eyebrow')
    heading = if account_name.present?
      t('devise_mailer.confirmation.invite_heading_account', account_name: account_name)
    else
      t('devise_mailer.confirmation.invite_heading', brand_name: brand_name)
    end
    intro_text = if account_name.present?
      t('devise_mailer.confirmation.invite_intro_account', inviter: inviter.name, account_name: account_name, brand_name: brand_name)
    else
      t('devise_mailer.confirmation.invite_intro', inviter: inviter.name, brand_name: brand_name)
    end
    supporting_text = t('devise_mailer.confirmation.invite_supporting')
    action_text = t('devise_mailer.confirmation.invite_action')
    reset_password_params = { reset_password_token: @resource.send(:set_reset_password_token) }
    reset_password_params[:route_url] = params[:redirect_url] if params[:redirect_url].present?
    reset_password_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present?
    action_url = frontend_url('auth/password/edit', **reset_password_params)
    detail_rows = [[t('devise_mailer.confirmation.invited_by_label'), inviter.name]]
    detail_rows << [t('devise_mailer.confirmation.workspace_label'), account_name] if account_name.present?
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
